{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug unit tests in library 'stereokit-rust'",
      "cargo": {
        "args": [
          "test",
          "--no-run",
          "--lib",
          "--package=stereokit-rust",
        ],
        "filter": {
          "name": "stereokit-rust",
          "kind": "lib"
        }
      },
      "args": [],
      "cwd": "${workspaceFolder}",
      "env": {
        "PATH": "${workspaceFolder}/target/debug/deps;${env:PATH}"
      }
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug with simulator 'demos'",
      "cargo": {
        "args": [
          "build",
          "-F",
          "tools",
          "--example=main_pc"
        ],
        "filter": {
          "name": "main_pc",
          "kind": "example"
        }
      },
      "args": [
        "--test",
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "PATH": "${workspaceFolder}/target/debug/deps;${env:PATH}"
      }
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug with PC headset 'demos'",
      "cargo": {
        "args": [
          "build",
          "-F",
          "tools",
          "--example=main_pc"
        ],
        "filter": {
          "name": "main_pc",
          "kind": "example"
        }
      },
      "args": [],
      "cwd": "${workspaceFolder}",
      "env": {
        "PATH": "${workspaceFolder}/target/debug/deps;${env:PATH}"
      }
    },
    // ... existing code ...
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug Monado XR simulator 'demos'",
      "cargo": {
        "args": [
          "run",
          "-F",
          "tools",
          "--example=main_pc"
        ],
        "filter": {
          "name": "main_pc",
          "kind": "example"
        }
      },
      "args": [
        "--start",
        "Documents1"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "XR_RUNTIME_JSON": "/usr/share/openxr/1/openxr_monado.json",
        "PATH": "${workspaceFolder}/target/debug/deps;${env:PATH}"
      }
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug 'manual' example (without framework, event loop, tools)",
      "cargo": {
        "args": [
          "build",
          "--features",
          "no-event-loop",
          "--example=manual"
        ],
        "filter": {
          "name": "manual",
          "kind": "example"
        }
      },
      "args": [],
      "cwd": "${workspaceFolder}",
      "env": {
        "PATH": "${workspaceFolder}/target/debug/deps;${env:PATH}"
      }
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug 'test' example",
      "cargo": {
        "args": [
          "build",
          "--example=test"
        ],
        "filter": {
          "name": "test",
          "kind": "example"
        }
      },
      "args": [],
      "cwd": "${workspaceFolder}",
      "env": {
        "PATH": "${workspaceFolder}/target/debug/deps;${env:PATH}"
      }
    },
    {
      "name": "GDB Attach",
      "type": "cppdbg",
      "request": "attach",
      "processId": "${input:pickExampleProcess}",
      "program": "${workspaceFolder}/../sk_builds/SK_demo_win_gnu/main_pc.exe",
      "MIMode": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        },
        {
          "description": "Set Disassembly Flavor to Intel",
          "text": "-gdb-set disassembly-flavor intel",
          "ignoreFailures": true
        }
      ]
    },
    {
      "name": "GDB Attach from external build",
      "type": "cppdbg",
      "request": "attach",
      "processId": "${input:pickExampleProcess}",
      "program": "${workspaceFolder}/../PartageWinLin/StereoKit-rust-exe/main_pc.exe",
      "MIMode": "gdb",
      "sourceFileMap": {
        "c:/Users/mvida/dvlt/StereoKit-rust": "${workspaceFolder}"
      },
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        },
        {
          "description": "Set Disassembly Flavor to Intel",
          "text": "-gdb-set disassembly-flavor intel",
          "ignoreFailures": true
        }
      ]
    },
  ],
  "inputs": [
    {
      "id": "pickExampleProcess",
      "type": "command",
      "command": "lldb.pickProcess",
      "args": {
        "initCommands": [], // Eg., platform select/connect commands.
        "filter": "main_pc" // RegExp to filter processes to.
      }
    }
  ]
}